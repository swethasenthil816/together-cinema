# Together Cinema - Production Environment Variables
# Copy this file and fill in real values on your deployment platform (Render, Railway, etc.)
# NEVER commit the actual .env file with real secrets!

# Server port (Render sets this automatically to 10000)
PORT=10000

# MongoDB connection string from MongoDB Atlas
# Get this from: https://cloud.mongodb.com → Connect → Drivers
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/together_cinema
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/together_cinema?retryWrites=true&w=majority

# JWT secret key — make this a long random string (32+ chars)
# Generate one at: https://randomkeygen.com or use Render's "Generate Value" button
JWT_SECRET=replace_with_very_long_random_secret_at_least_32_characters

# Your deployed app URL (set AFTER first deploy — it's the URL Render gives you)
# Example: https://together-cinema.onrender.com
CLIENT_URL=https://your-app-name.onrender.com

# Path where uploaded movies are stored
# On Render with persistent disk: /opt/render/project/src/server/uploads
# Locally: leave blank (defaults to ./server/uploads)
UPLOAD_DIR=/opt/render/project/src/server/uploads

# Node environment
NODE_ENV=production
