# ==============================================================
# Together Cinema ❤️ - Environment Variables Template
# NEVER commit the real .env file with secrets to GitHub!
# ==============================================================

# Server Port (Render automatically sets this to 10000 in production)
PORT=10000
NODE_ENV=production

# --------------------------------------------------------------
# 1. MongoDB Atlas Database
# --------------------------------------------------------------
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/togethercinema?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/togethercinema?retryWrites=true&w=majority

# --------------------------------------------------------------
# 2. JWT Authentication Secret
# --------------------------------------------------------------
# On Render: Handled automatically with generateValue: true in render.yaml
# For local development: Set to a 32+ character random string
JWT_SECRET=replace_with_a_super_secret_random_string_at_least_32_characters

# --------------------------------------------------------------
# 3. Client URL / CORS
# --------------------------------------------------------------
# Set to your deployed Render URL (e.g. https://together-cinema.onrender.com)
CLIENT_URL=https://together-cinema.onrender.com

# --------------------------------------------------------------
# 4. Cloud Video Storage (Cloudflare R2 or AWS S3)
# --------------------------------------------------------------
# Recommended: Cloudflare R2 has 10GB free storage and $0 egress bandwidth fees!
STORAGE_PROVIDER=r2

# Cloudflare R2 Credentials:
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=together-cinema-movies
# Optional: R2 public URL or custom domain (e.g. https://pub-xxxxxx.r2.dev or https://media.yourdomain.com)
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# Or AWS S3 Credentials (if using AWS S3 instead of R2):
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=ap-southeast-1
# AWS_BUCKET_NAME=together-cinema-movies
# AWS_PUBLIC_URL=https://your-bucket.s3.amazonaws.com

# --------------------------------------------------------------
# 5. Local Uploads Directory (Dev / Fallback only)
# --------------------------------------------------------------
UPLOAD_DIR=./uploads
