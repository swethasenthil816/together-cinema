PORT=5000
NODE_ENV=development

# MongoDB Atlas URI (or mongodb://localhost:27017/togethercinema for local dev)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/togethercinema?retryWrites=true&w=majority

# JWT secret (32+ chars)
JWT_SECRET=together_cinema_super_secret_romantic_key_2026

# Client origin for CORS
CLIENT_URL=http://localhost:5173

# Cloud Video Storage (Cloudflare R2 or AWS S3)
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Local uploads fallback directory
UPLOAD_DIR=./uploads
